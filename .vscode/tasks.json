{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "2048: start nginx",
      "type": "process",
      "command": "docker",
      "args": [
        "compose", "--project-name", "2048-ai-vscode",
        "--file", "${workspaceFolder}/compose.debug.yaml",
        "up", "--detach", "--wait", "--wait-timeout", "30"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "2048: stop nginx",
      "type": "process",
      "command": "docker",
      "args": [
        "compose", "--project-name", "2048-ai-vscode",
        "--file", "${workspaceFolder}/compose.debug.yaml",
        "down", "--remove-orphans"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    }
  ]
}
